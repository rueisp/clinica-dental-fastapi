            <Link href="/terminos" className="text-gray-400 hover:text-white">Términos</Link>
          </div>
        </div>
      </footer>
    </main>
  );
}

// Exportación principal con Suspense para evitar errores en build
export default function LandingPage() {
  return (
    <Suspense fallback={null}>
      <LandingContent />
    </Suspense>
  );
}
