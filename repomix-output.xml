            onChange={handleChange}
            rows="2"
            className="w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-black/20 text-sm"
          ></textarea>
        </div>
      </div>
    </div>
  );
}
