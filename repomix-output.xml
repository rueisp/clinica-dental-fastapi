                  ? 'md:ml-0 p-0' 
                  : 'p-4 lg:p-8 md:ml-80 pt-16 md:pt-8'
              }`}
            >
              {children}
            </main>
          </div>
        </UserProvider>
      </body>
    </html>
  );
}
