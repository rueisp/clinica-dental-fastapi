                className="w-full p-3 bg-gray-50 rounded-xl text-black font-bold"
                placeholder="0"
                required
              />
            </div>
            <div>
              <label className="text-xs font-bold text-gray-500 uppercase">Método</label>
              <select 
                value={form.metodo_pago}
