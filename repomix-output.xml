  border: none !important;
}

/* Números de los días */
.fc-daygrid-day-number {
  font-weight: 750 !important;
  font-size: 1rem !important;
  padding-right: 20px !important;
  text-align: right !important;
}

/* --- MÓVIL (Tu configuración original) --- */
@media (max-width: 768px) {
  .fc .fc-daygrid-day-frame {
    min-height: 80px !important;
  }
  
  .fc-header-toolbar {
    flex-direction: column !important;
    gap: 0.5rem !important;
    margin: 0 0 1rem 0 !important;
    padding: 0 0.5rem !important;
  }
  
  .fc-toolbar-title {
    font-size: 3.1rem !important; /* El tamaño grande que te gusta */
  }
  
  /* ESTE ES EL TRUCO PARA EL LOOK IPHONE QUE ROMPE MÁRGENES */
  .fc {
    width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
  }
  
  /* Quitar líneas laterales */
  .fc-theme-standard td, 
  .fc-theme-standard th {
    border-left: none !important;
    border-right: none !important;
  }

  .fc-daygrid-day {
    border-bottom: 1px solid #f0f0f0 !important;
  }

  .fc-scrollgrid {
    border: none !important;
  }
}

/* --- DÍA ACTUAL (Círculo Negro) --- */
.fc-daygrid-day.fc-day-today .fc-daygrid-day-number {
  background-color: #000 !important;
  color: #fff !important;
  border-radius: 50% !important;
  width: 36px !important;
  height: 36px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 auto !important;
}

.fc-daygrid-day.fc-day-today {
  background-color: transparent !important;
}

/* Hace que el clic pase a través de la cápsula hacia el día */
.fc-event {
