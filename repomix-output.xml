        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-4">
          <div>
            <p className="text-xs text-gray-500">Nombres</p>
            <p className="text-sm font-medium text-black">{paciente?.nombres || 'N/A'}</p>
