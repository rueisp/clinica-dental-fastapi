                  >
                    {p.nombres} {p.apellidos}
                  </div>
                ))}
              </div>
            )}
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="text-xs font-bold text-gray-500 uppercase">Monto (COP)</label>
              <input
                type="number"
