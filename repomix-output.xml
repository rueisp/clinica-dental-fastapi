/* RESETEO TOTAL PARA LOOK IPHONE */
body {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

.fc {
  width: 100% !important;
}

.fc .fc-view-harness {
  width: 100% !important;
}

/* Texto de eventos (Tus rayos morados) */
