              />
            </div>
            {mostrarSugerencias && pacientes.length > 0 && (
              <div className="absolute z-10 w-full bg-white border rounded-xl shadow-lg mt-1">
                {pacientes.map(p => (
                  <div 
                    key={p.id} 
