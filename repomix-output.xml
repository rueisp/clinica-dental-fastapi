      const timer = setTimeout(async () => {
        const res = await authFetch(`${API_ENDPOINTS.PACIENTES}?search=${busqueda}`);
        if (res.ok) {
          const data = await res.json();
          setPacientes(data.pacientes || []);
        }
      }, 300);
      return () => clearTimeout(timer);
    }
  }, [busqueda]);

  const seleccionarPaciente = (p) => {
