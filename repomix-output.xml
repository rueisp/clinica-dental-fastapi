        total_pacientes = count_result.scalar() or 0

        respuesta.append({
            "id": str(user.id),
            "nombre": f"{user.nombres} {user.apellidos}",
            "email": user.email,
            "plan_actual": sub.plan_type,
            "estado": sub.status,
