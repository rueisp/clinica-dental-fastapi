    useEffect(() => { cargarPagos(); }, []);

    const handleAprobar = async (id) => {
        if (!confirm("¿Confirmas que el dinero está en tu cuenta?")) return;
        try {
            const res = await authFetch(API_ENDPOINTS.APROBAR_PAGO(id), { method: 'POST' });
